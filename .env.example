# =============================================================================
# AI PORTFOLIO BACKEND - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# AWS CONFIGURATION
# -----------------------------------------------------------------------------
# Your AWS credentials and region
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Profile (alternative to access key/secret - recommended for local dev)
AWS_PROFILE=default

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Environment: dev, staging, or prod
ENVIRONMENT=dev
STAGE=dev

# Project name (used for resource naming)
PROJECT_NAME=ai-portfolio

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION
# -----------------------------------------------------------------------------
# OpenAI API key for local development
# In production, this is stored in AWS Secrets Manager
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# OpenAI model configuration
OPENAI_MODEL=
OPENAI_MAX_TOKENS=
OPENAI_TEMPERATURE=

# -----------------------------------------------------------------------------
# S3 BUCKET NAMES
# -----------------------------------------------------------------------------
# These will be auto-generated by Terraform with format:
# {PROJECT_NAME}-{ENVIRONMENT}-{bucket-type}-{random-suffix}
# Fill these in after Terraform creates them, or leave empty for local mocking

QUARANTINE_BUCKET_NAME=
VALIDATED_BUCKET_NAME=
REJECTED_BUCKET_NAME=
PORTFOLIO_BUCKET_NAME=

# -----------------------------------------------------------------------------
# DYNAMODB CONFIGURATION
# -----------------------------------------------------------------------------
# DynamoDB table name (auto-generated by Terraform)
DYNAMODB_TABLE_NAME=

# Local DynamoDB endpoint (for local testing with DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:8000

# -----------------------------------------------------------------------------
# SQS CONFIGURATION
# -----------------------------------------------------------------------------
# SQS queue URLs (auto-generated by Terraform)
PROCESSING_QUEUE_URL=
DLQ_URL=

# SQS Configuration
SQS_VISIBILITY_TIMEOUT=310
SQS_MESSAGE_RETENTION_DAYS=4
DLQ_MAX_RECEIVE_COUNT=3

# -----------------------------------------------------------------------------
# COGNITO CONFIGURATION
# -----------------------------------------------------------------------------
# Cognito User Pool (auto-generated by Terraform)
USER_POOL_ID=
USER_POOL_CLIENT_ID=
USER_POOL_DOMAIN=

# Cognito password policy
COGNITO_PASSWORD_MIN_LENGTH=8
COGNITO_PASSWORD_REQUIRE_UPPERCASE=true
COGNITO_PASSWORD_REQUIRE_LOWERCASE=true
COGNITO_PASSWORD_REQUIRE_NUMBERS=true
COGNITO_PASSWORD_REQUIRE_SYMBOLS=false

# -----------------------------------------------------------------------------
# API GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
# API Gateway endpoint (auto-generated by Terraform)
API_GATEWAY_URL=
API_GATEWAY_STAGE=dev

# Rate limiting
API_RATE_LIMIT=10
API_BURST_LIMIT=20

# -----------------------------------------------------------------------------
# CLOUDFRONT CONFIGURATION
# -----------------------------------------------------------------------------
# CloudFront distribution (auto-generated by Terraform)
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=

# -----------------------------------------------------------------------------
# UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
# File upload limits
MAX_UPLOAD_SIZE_MB=10
PRESIGNED_URL_EXPIRY_SECONDS=300

# Allowed file types
ALLOWED_EXTENSIONS=.pdf,.docx
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# -----------------------------------------------------------------------------
# LAMBDA CONFIGURATION
# -----------------------------------------------------------------------------
# Lambda function settings (for local testing/reference)
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_SIZE=256
LAMBDA_RESERVED_CONCURRENCY=

# Lambda layer ARN (if using shared dependencies)
LAMBDA_LAYER_ARN=

# -----------------------------------------------------------------------------
# SECRETS MANAGER
# -----------------------------------------------------------------------------
# Secret name for OpenAI API key (auto-generated by Terraform)
OPENAI_SECRET_NAME=ai-portfolio-dev-openai-api-key

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured logging (JSON format)
ENABLE_STRUCTURED_LOGGING=true

# CloudWatch log group prefix
LOG_GROUP_PREFIX=/aws/lambda/ai-portfolio-dev

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=false

# -----------------------------------------------------------------------------
# VALIDATION CONFIGURATION
# -----------------------------------------------------------------------------
# File validation settings
MAX_FILE_SIZE_MB=10
MAX_DECOMPRESSED_SIZE_MB=50
MAX_ZIP_FILES=100

# Resume validation
MIN_RESUME_LENGTH_CHARS=100
MAX_RESUME_LENGTH_CHARS=50000

# Malware scanning
ENABLE_MALWARE_SCANNING=true

# -----------------------------------------------------------------------------
# AI PROCESSING CONFIGURATION
# -----------------------------------------------------------------------------
# AI processing timeouts
AI_PROCESSING_TIMEOUT=300
AI_MAX_RETRIES=3
AI_RETRY_DELAY_SECONDS=5

# AI processing queue concurrency
AI_MAX_CONCURRENT_EXECUTIONS=5

# -----------------------------------------------------------------------------
# PORTFOLIO GENERATION
# -----------------------------------------------------------------------------
# Portfolio versioning
ENABLE_PORTFOLIO_VERSIONING=true
MAX_PORTFOLIO_VERSIONS=5

# Portfolio template
PORTFOLIO_TEMPLATE=default
PORTFOLIO_THEME=professional

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CORS settings
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# -----------------------------------------------------------------------------
# TESTING & DEVELOPMENT
# -----------------------------------------------------------------------------
# Enable debug mode (verbose logging, stack traces, etc.)
DEBUG=false

# Mock external services (for unit testing)
MOCK_OPENAI=false
MOCK_S3=false
MOCK_DYNAMODB=false

# Test data
TEST_USER_ID=test-user-123
TEST_RESUME_PATH=tests/fixtures/sample_resume.pdf

# -----------------------------------------------------------------------------
# PERFORMANCE & OPTIMIZATION
# -----------------------------------------------------------------------------
# Enable caching
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# Connection pooling
DB_CONNECTION_POOL_SIZE=10
HTTP_CONNECTION_POOL_SIZE=10

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Enable additional security checks
ENABLE_SECURITY_HEADERS=true
ENABLE_REQUEST_SIGNING=true

# JWT configuration
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# IP allowlist (comma-separated, empty = allow all)
IP_ALLOWLIST=

# Rate limiting per user
USER_RATE_LIMIT_PER_HOUR=10
USER_RATE_LIMIT_PER_DAY=50

# -----------------------------------------------------------------------------
# COST CONTROLS
# -----------------------------------------------------------------------------
# Maximum AI API calls per day (cost protection)
MAX_AI_CALLS_PER_DAY=1000

# Maximum S3 storage per user (MB)
MAX_STORAGE_PER_USER_MB=100

# Alert thresholds
COST_ALERT_THRESHOLD_USD=100
STORAGE_ALERT_THRESHOLD_GB=10
